# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report
/test-results
/blob-report

# raw submission captures (generated locally and in CI; the form uses the PNGs)
/submission/screenshots/*.png
!/submission/screenshots/.gitkeep

# --- VELLITAXIS secret baseline ---
# Values file referenced by the committed SECRETS.md index; never tracked.
docs/velitaxis/SECRETS.local.md
SECRETS.local.md

# keys, certificates, keystores
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
.grc

# service-account / cloud credential files
credentials.json
credentials
client_secrets.json
google-services.json
FirebaseApp-*.json
local.settings.json
.aws/
.gcloud/
.azure/
*.tfvars
*.tfstate
*.tfstate.*
.vscode/mcp.json

# package managers that can capture tokens
.npmrc
.yarnrc.yml
.netrc
